{
	"schemaVersion": 1,
	"id": "konocraft",
	"version": "${version}",
	"name": "KonoCraft: Благословение кубическому миру!",
	"description": "Сюжетный фан-мод по мотивам KonoSuba: Аксель, Мегумин, Аква, Даркнесс, Взрыв!, Бельдия и Мобильная крепость Разрушитель.",
	"authors": ["Gr1tW4lk", "Claude"],
	"contact": {
		"sources": "https://github.com/Gr1tW4lk/Conosubavvmaincraft"
	},
	"license": "MIT",
	"icon": "assets/konocraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.konocraft.KonoCraft"],
		"client": ["dev.konocraft.client.KonoCraftClient"]
	},
	"mixins": [
		"konocraft.mixins.json",
		{
			"config": "konocraft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}
